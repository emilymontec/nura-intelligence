# Copia este archivo a ".env" en la raíz del proyecto y ajusta los valores.
#
# GUÍA RÁPIDA PARA CORRER EN LOCAL SIN DOCKER:
#   1. cp .env.example .env
#   2. python -m venv venv && source venv/bin/activate  (o venv\Scripts\activate en Windows)
#   3. pip install -r requirements.txt
#   4. python manage.py migrate
#   5. python manage.py createsuperuser   (opcional, para entrar a /admin/)
#   6. python manage.py runserver
#   7. En OTRA terminal: cd frontend && npm install && npm run dev
#   8. Abre http://localhost:5173  (NO http://localhost:8000 — ese es solo la API)

# --- Django ---
DJANGO_SECRET_KEY=dev-secret-key-cambiala-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Base de datos ---
# Si dejas DATABASE_URL vacío/comentado, el proyecto usa SQLite automáticamente
# (ideal para desarrollo local sin instalar Postgres). Para usar Postgres
# (como en Docker), descomenta y ajusta la siguiente línea:
# DATABASE_URL=postgres://usuario:password@localhost:5432/nura

# --- Celery / Redis (opcional) ---
# Si lo dejas vacío, las tareas de análisis corren de forma síncrona en el
# mismo proceso (no necesitas Redis para probar en local). Para activar
# procesamiento asíncrono real, levanta Redis y descomenta:
# REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Proveedores de IA (el chat no funcionará sin al menos uno) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Email (opcional, para verificación de cuenta / recuperación de contraseña) ---
DEFAULT_FROM_EMAIL=no-reply@nura.local
MAILGUN_DOMAIN=

# --- Almacenamiento de archivos (opcional, Supabase) ---
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=
SUPABASE_BUCKET_NAME=

# --- Logging / Monitoring (Módulo 0, opcional) ---
# Nivel de log de la app (chat/ai/analytics). En desarrollo por defecto es
# DEBUG; en producción (DJANGO_DEBUG=False) es INFO. Puedes overridearlo:
# DJANGO_LOG_LEVEL=INFO
#
# Si dejas SENTRY_DSN vacío, el proyecto corre igual sin reportar errores a
# ningún lado externo (solo a consola/docker logs). Para activar reporte de
# errores en producción, crea un proyecto en sentry.io y pega su DSN:
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
