# Copia este archivo a ".env" dentro de /frontend.
#
# En desarrollo (`npm run dev`) normalmente NO necesitas tocar esto: Vite
# ya redirige automáticamente las peticiones a /api hacia el backend en
# http://localhost:8000 (ver vite.config.js). Solo defínelo si tu backend
# corre en otra URL/puerto.
VITE_API_URL=http://localhost:8000
